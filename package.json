{
  "name": "rbc-go",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "concurrently -k -n customer,api,admin,website \"pnpm dev:customer\" \"pnpm dev:api\" \"pnpm dev:admin\" \"pnpm dev:website\"",
    "dev:customer": "pnpm --filter @stackbuild/customer dev",
    "dev:admin": "pnpm --filter @stackbuild/admin dev",
    "dev:website": "pnpm --filter @stackbuild/website dev",
    "dev:api": "node scripts/run-api.mjs",
    "dev:infra": "docker compose up -d database redis",
    "build": "pnpm build:customer && pnpm build:admin && pnpm build:website && pnpm build:api",
    "build:customer": "pnpm --filter @stackbuild/customer build",
    "build:admin": "pnpm --filter @stackbuild/admin build",
    "build:website": "pnpm --filter @stackbuild/website build",
    "build:api": "cd apps/api && go build -o ../../.build/rbc-go-api ./cmd/api",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm test:frontend && pnpm test:api",
    "test:frontend": "vitest run",
    "test:api": "cd apps/api && go test ./...",
    "test:e2e": "playwright test",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rimraf apps/*/dist apps/*/.next apps/*/.next-dev .build"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "concurrently": "10.0.5",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  }
}
